# Betfair credentials — keep out of version control; use a secrets manager in production.
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=

# Certificate login (recommended for unattended bots)
BETFAIR_CERT_FILE=/path/to/client-2048.crt
BETFAIR_KEY_FILE=/path/to/client-2048.key

# Live trading double-confirmation: config mode must be "live" AND this must be YES.
# Leave unset for paper trading.
# BETFAIR_LIVE_CONFIRM=YES

# Optional: enables LLM news fact extraction (extract/classify only)
# ANTHROPIC_API_KEY=
