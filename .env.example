# --- Existing dashboard (unchanged) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Comedian feature ---
# Service role key is required by the server-side Supabase client the webhook uses.
# Get it from: Supabase Dashboard -> Project Settings -> API -> service_role secret.
# NEVER expose this key to the browser. It is used only in API routes (node runtime).
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (character brain)
ANTHROPIC_API_KEY=

# OpenAI (Whisper transcription of incoming voice notes)
OPENAI_API_KEY=

# ElevenLabs (character voice for outgoing voice notes)
ELEVENLABS_API_KEY=

# WhatsApp Business Cloud API
#   Graph version Meta is using for this app (default v21.0)
WHATSAPP_GRAPH_VERSION=v21.0
#   Long-lived System User token with whatsapp_business_messaging permission
WHATSAPP_ACCESS_TOKEN=
#   Token you make up; paste the same value in Meta's webhook config to complete the handshake
WHATSAPP_VERIFY_TOKEN=
#   App Secret from Meta App Dashboard -> Settings -> Basic. Used to verify webhook signatures.
WHATSAPP_APP_SECRET=
